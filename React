import React, { useState, useEffect } from "react";
import Tesseract from "tesseract.js";

export default function TradutorGamerPro() {
  const [imagem, setImagem] = useState(null);
  const [texto, setTexto] = useState("");
  const [traducao, setTraducao] = useState("");
  const [historico, setHistorico] = useState([]);
  const [darkMode, setDarkMode] = useState(true);
  const [idiomaOrigem, setIdiomaOrigem] = useState("en");
  const [idiomaDestino, setIdiomaDestino] = useState("pt");
  const [autoTranslate, setAutoTranslate] = useState(true);
  const [loading, setLoading] = useState(false);
  const [progresso, setProgresso] = useState(0);
  const [ultimoTexto, setUltimoTexto] = useState("");

  const idiomasOCR = {
    pt: "por",
    en: "eng",
    es: "spa",
    fr: "fra",
    de: "deu",
    ja: "jpn"
  };

  useEffect(() => {
    const salvo = localStorage.getItem("historicoTradutor");

    if (salvo) {
      try {
        setHistorico(JSON.parse(salvo));
      } catch {
        setHistorico([]);
      }
    }
  }, []);

  useEffect(() => {
    localStorage.setItem(
      "historicoTradutor",
      JSON.stringify(historico)
    );
  }, [historico]);

  useEffect(() => {
    return () => {
      if (imagem) {
        URL.revokeObjectURL(imagem);
      }
    };
  }, [imagem]);

  useEffect(() => {
    const atalhos = (e) => {
      if (e.key === "F8") {
        e.preventDefault();
        narrar();
      }

      if (e.key === "F9") {
        e.preventDefault();
        limparHistorico();
      }

      if (e.key === "F10") {
        e.preventDefault();
        setDarkMode((v) => !v);
      }
    };

    window.addEventListener("keydown", atalhos);

    return () =>
      window.removeEventListener(
        "keydown",
        atalhos
      );
  }, [traducao]);

  useEffect(() => {
    if (
      !autoTranslate ||
      !texto ||
      texto === ultimoTexto
    ) {
      return;
    }

    const timer = setTimeout(() => {
      traduzir(texto);
      setUltimoTexto(texto);
    }, 1000);

    return () => clearTimeout(timer);
  }, [
    texto,
    idiomaOrigem,
    idiomaDestino,
    autoTranslate,
    ultimoTexto
  ]);

  const reconhecerTexto = async (arquivo) => {
    setLoading(true);
    setProgresso(0);

    try {
      const resultado =
        await Tesseract.recognize(
          arquivo,
          idiomasOCR[idiomaOrigem] || "eng",
          {
            logger: (m) => {
              if (
                m.status ===
                "recognizing text"
              ) {
                setProgresso(
                  Math.round(
                    m.progress * 100
                  )
                );
              }
            }
          }
        );

      setTexto(resultado.data.text);
    } catch (erro) {
      console.error(erro);
      alert(
        "Erro ao reconhecer texto."
      );
    }

    setLoading(false);
  };

  const traduzir = async (conteudo) => {
    if (!conteudo.trim()) return;

    try {
      const resposta = await fetch(
        `https://api.mymemory.translated.net/get?q=${encodeURIComponent(
          conteudo
        )}&langpair=${idiomaOrigem}|${idiomaDestino}`
      );

      if (!resposta.ok) {
        throw new Error(
          "Erro na tradução"
        );
      }

      const dados =
        await resposta.json();

      const textoTraduzido =
        dados?.responseData
          ?.translatedText || "";

      setTraducao(textoTraduzido);

      setHistorico((antigo) => {
        if (
          antigo.length > 0 &&
          antigo[0].original ===
            conteudo
        ) {
          return antigo;
        }

        return [
          {
            original: conteudo,
            traduzido:
              textoTraduzido,
            data: new Date().toLocaleString()
          },
          ...antigo.slice(0, 49)
        ];
      });
    } catch (erro) {
      console.error(erro);
    }
  };

  const narrar = () => {
    if (!traducao) return;

    if (
      !("speechSynthesis" in window)
    ) {
      alert(
        "Seu navegador não suporta voz."
      );
      return;
    }

    window.speechSynthesis.cancel();

    const voz =
      new SpeechSynthesisUtterance(
        traducao
      );

    voz.lang =
      idiomaDestino === "pt"
        ? "pt-BR"
        : idiomaDestino;

    voz.rate = 1;
    voz.pitch = 1;
    voz.volume = 1;

    window.speechSynthesis.speak(
      voz
    );
  };

  const limparHistorico = () => {
    setHistorico([]);
    localStorage.removeItem(
      "historicoTradutor"
    );
  };

  return (
    <div
      style={{
        minHeight: "100vh",
        padding: 20,
        background: darkMode
          ? "#111"
          : "#f5f5f5",
        color: darkMode
          ? "#fff"
          : "#000",
        fontFamily: "Arial"
      }}
    >
      <h1>
        🎮 Tradutor Gamer Pro
      </h1>

      <button
        onClick={() =>
          setDarkMode(
            !darkMode
          )
        }
      >
        {darkMode
          ? "☀️ Claro"
          : "🌙 Escuro"}
      </button>

      <label
        style={{
          marginLeft: 15
        }}
      >
        <input
          type="checkbox"
          checked={autoTranslate}
          onChange={() =>
            setAutoTranslate(
              !autoTranslate
            )
          }
        />
        Tradução Automática
      </label>

      <hr />

      <input
        type="file"
        accept="image/*"
        onChange={(e) => {
          const file =
            e.target.files?.[0];

          if (!file) return;

          const novaImagem =
            URL.createObjectURL(
              file
            );

          setImagem(
            novaImagem
          );

          reconhecerTexto(
            file
          );
        }}
      />

      <div
        style={{
          marginTop: 15
        }}
      >
        <label>
          Origem:
        </label>

        <select
          value={
            idiomaOrigem
          }
          onChange={(e) =>
            setIdiomaOrigem(
              e.target.value
            )
          }
        >
          <option value="en">
            Inglês
          </option>
          <option value="pt">
            Português
          </option>
          <option value="es">
            Espanhol
          </option>
          <option value="fr">
            Francês
          </option>
          <option value="de">
            Alemão
          </option>
          <option value="ja">
            Japonês
          </option>
        </select>

        <label
          style={{
            marginLeft: 15
          }}
        >
          Destino:
        </label>

        <select
          value={
            idiomaDestino
          }
          onChange={(e) =>
            setIdiomaDestino(
              e.target.value
            )
          }
        >
          <option value="pt">
            Português
          </option>
          <option value="en">
            Inglês
          </option>
          <option value="es">
            Espanhol
          </option>
          <option value="fr">
            Francês
          </option>
          <option value="de">
            Alemão
          </option>
          <option value="ja">
            Japonês
          </option>
        </select>
      </div>

      {imagem && (
        <img
          src={imagem}
          alt="captura"
          style={{
            width: "100%",
            maxHeight: 300,
            objectFit:
              "contain",
            marginTop: 15,
            borderRadius: 10
          }}
        />
      )}

      {loading && (
        <p>
          🔍 OCR:
          {" "}
          {progresso}%
        </p>
      )}

      <h2>
        Texto Detectado
      </h2>

      <textarea
        rows={8}
        value={texto}
        onChange={(e) =>
          setTexto(
            e.target.value
          )
        }
        style={{
          width: "100%"
        }}
      />

      <h2>Tradução</h2>

      <textarea
        rows={8}
        value={traducao}
        readOnly
        style={{
          width: "100%"
        }}
      />

      <div
        style={{
          marginTop: 15
        }}
      >
        <button
          onClick={() =>
            traduzir(texto)
          }
        >
          Traduzir
        </button>

        <button
          onClick={narrar}
          style={{
            marginLeft: 10
          }}
        >
          🔊 Narrar
        </button>

        <button
          onClick={
            limparHistorico
          }
          style={{
            marginLeft: 10
          }}
        >
          Limpar Histórico
        </button>
      </div>

      <h2>Histórico</h2>

      {historico.length ===
      0 ? (
        <p>
          Nenhuma tradução
          realizada.
        </p>
      ) : (
        historico.map(
          (
            item,
            index
          ) => (
            <div
              key={index}
              style={{
                border:
                  "1px solid #555",
                padding: 10,
                marginTop: 10,
                borderRadius: 8
              }}
            >
              <small>
                {item.data}
              </small>

              <p>
                <strong>
                  Original:
                </strong>{" "}
                {
                  item.original
                }
              </p>

              <p>
                <strong>
                  Tradução:
                </strong>{" "}
                {
                  item.traduzido
                }
              </p>
            </div>
          )
        )
      )}

      <hr />

      <p>
        F8 = Narrar |
        F9 = Limpar Histórico |
        F10 = Alternar Tema
      </p>
    </div>
  );
}